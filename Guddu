<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>For Kaveri, With Love</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display&family=Raleway&display=swap');

  body {
    margin: 0; padding: 0;
    font-family: 'Raleway', sans-serif;
    background: #fff0f5;
    color: #c77f90;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Rose gold shimmer background animation */
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  body::before {
    content: "";
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, #c77f90, #f0c0b5, #c77f90);
    background-size: 400% 100%;
    animation: shimmer 10s linear infinite;
    opacity: 0.15;
    z-index: -1;
  }

  header {
    padding: 40px 20px 10px;
    text-align: center;
    font-family: 'Playfair Display', serif;
    z-index: 10;
  }
  header h1 {
    font-size: 3.5rem;
    margin-bottom: 5px;
  }
  header h2 {
    font-weight: normal;
    font-size: 1.3rem;
    color: #a45c6a;
    letter-spacing: 0.1em;
  }

  main {
    width: 90%;
    max-width: 700px;
    margin: 20px auto 40px;
    background: #ffe6f0;
    border-radius: 20px;
    padding: 30px 40px;
    box-shadow: 0 0 20px rgba(199, 127, 144, 0.4);
    position: relative;
    z-index: 10;
  }

  .love-lines {
    max-height: 200px;
    overflow-y: auto;
    margin-bottom: 30px;
    border: 1px solid #d9a6b6;
    padding: 15px;
    border-radius: 10px;
    background: #fff0f5;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.5;
    color: #914d61;
  }

  .poem {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    color: #b26178;
    margin-bottom: 30px;
    white-space: pre-line;
    text-align: center;
  }

  button.propose {
    background: linear-gradient(45deg, #c77f90, #a45c6a);
    border: none;
    color: white;
    font-size: 1.6rem;
    padding: 18px 50px;
    border-radius: 40px;
    cursor: pointer;
    transition: box-shadow 0.3s ease;
    display: block;
    margin: 0 auto;
    font-weight: 600;
    letter-spacing: 0.05em;
    box-shadow: 0 6px 15px rgba(199, 127, 144, 0.6);
  }
  button.propose:hover {
    box-shadow: 0 8px 20px rgba(164, 92, 106, 0.8);
  }

  #proposalMessage {
    margin-top: 40px;
    font-size: 2rem;
    color: #a45c6a;
    font-weight: 700;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.6s ease, transform 0.6s ease;
    text-align: center;
    user-select: none;
  }
  #proposalMessage.show {
    opacity: 1;
    transform: scale(1);
  }

  footer {
    font-size: 0.9rem;
    color: #cfa1ab;
    margin: 40px 0 20px;
    user-select: none;
    z-index: 10;
  }

  /* Floating hearts */
  .heart {
    position: fixed;
    bottom: -50px;
    width: 20px;
    height: 20px;
    background: #c77f90;
    transform: rotate(45deg);
    animation: floatUp linear forwards;
    opacity: 0.8;
    z-index: 5;
  }
  .heart::before,
  .heart::after {
    content: "";
    position: absolute;
    width: 20px;
    height: 20px;
    background: #c77f90;
    border-radius: 50%;
  }
  .heart::before {
    top: -10px;
    left: 0;
  }
  .heart::after {
    left: 10px;
    top: 0;
  }

  @keyframes floatUp {
    0% {
      transform: translateY(0) rotate(45deg);
      opacity: 0.8;
    }
    100% {
      transform: translateY(-700px) rotate(45deg);
      opacity: 0;
    }
  }

  /* Slideshow styles */
  .slideshow {
    position: relative;
    max-width: 100%;
    height: 220px;
    margin-bottom: 30px;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 0 20px rgba(199, 127, 144, 0.4);
  }
  .slideshow img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
    border-radius: 15px;
  }
  .slideshow img.active {
    display: block;
  }

  /* Countdown timer */
  .countdown {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: #914d61;
    margin-bottom: 30px;
    user-select: none;
  }
</style>
</head>
<body>

